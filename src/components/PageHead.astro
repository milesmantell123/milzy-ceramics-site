---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<section class="pagehead">
  <div class="wrap">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="display">{title}</h1>
    {lede && <p class="lede">{lede}</p>}
  </div>
</section>

<style>
  .pagehead {
    padding: clamp(2.5rem, 6vw, 5rem) 0 clamp(2.5rem, 5vw, 4rem);
  }
  .eyebrow {
    margin-bottom: 2rem;
  }
  .lede {
    max-width: 38rem;
    margin: 2.5rem 0 0;
    color: var(--stone);
  }
</style>
