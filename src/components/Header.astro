---
// Announcement bar, main bar with the Shop menu, and a row of quick links.
import { categories, surfaces, available, ETSY_SHOP, cover } from '../data/products';

const path = Astro.url.pathname;
const messages = [
  'Fresh from the soda kiln: new mugs, cups and bowls are in the shop',
  'Every piece is one of a kind, stamped MM on the foot',
  'Food, microwave and dishwasher safe. Made in Southern California.',
];
const quick = [
  { href: '/collection/?sort=new', label: 'New' },
  ...categories.map((c) => ({ href: `/collection/?category=${c.slug}`, label: c.name })),
  { href: '/surfaces/', label: 'The Surfaces' },
  { href: '/learn/', label: 'Learn' },
];
const promo = available.find((p) => p.category === 'Mugs') ?? available[0];
const promo2 = available.find((p) => p.category === 'Vases & Jars') ?? available[1];
const count = (slug: string) => available.filter((p) => categories.find((c) => c.slug === slug)?.name === p.category).length;
---

<div class="announce" role="region" aria-label="Announcements">
  <button class="announce__arrow" data-announce="-1" aria-label="Previous message">&lsaquo;</button>
  <div class="announce__track">
    {messages.map((m, i) => <p class:list={['announce__msg', { 'is-active': i === 0 }]}>{m}</p>)}
  </div>
  <button class="announce__arrow" data-announce="1" aria-label="Next message">&rsaquo;</button>
</div>

<header class="header">
  <div class="wrap header__bar">
    <nav class="header__left" aria-label="Main">
      <button class="shop-toggle" aria-expanded="false" aria-controls="mega">
        Shop <span aria-hidden="true" class="chev">&#8964;</span>
      </button>
      <a href="/surfaces/" class="hide-sm" aria-current={path.startsWith('/surfaces') ? 'page' : undefined}>Surfaces</a>
      <a href="/learn/" class="hide-sm" aria-current={path.startsWith('/learn') ? 'page' : undefined}>Learn</a>
      <a href="/studio/" class="hide-sm" aria-current={path.startsWith('/studio') ? 'page' : undefined}>Our Story</a>
    </nav>

    <a href="/" class="wordmark" aria-label="Milzy Ceramics, home">Milzy</a>

    <div class="header__right">
      <a href="/care/" class="hide-sm">Help</a>
      <a href="/contact/" class="hide-sm">Commissions</a>
      <a href={ETSY_SHOP} rel="noopener" class="bag" aria-label="Shop on Etsy">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4">
          <path d="M5 8h14l-1.2 12H6.2z" /><path d="M9 8V6.5a3 3 0 0 1 6 0V8" />
        </svg>
        <span class="hide-sm">Etsy</span>
      </a>
    </div>
  </div>

  <div class="mega" id="mega" hidden>
    <div class="wrap mega__inner">
      <div class="mega__col">
        <p class="eyebrow">Shop by kind</p>
        <a href="/collection/" class="mega__all">Shop all pieces <span>{available.length}</span></a>
        {categories.map((c) => (
          <a href={`/collection/?category=${c.slug}`}>{c.name} <span>{count(c.slug)}</span></a>
        ))}
      </div>
      <div class="mega__col">
        <p class="eyebrow">Shop by surface</p>
        {surfaces.map((s) => (
          <a href={`/collection/?surface=${s.id}`} class="mega__surface">
            <span class="swatch" style={`background:${s.swatch}`}></span>{s.name}
          </a>
        ))}
      </div>
      <div class="mega__col">
        <p class="eyebrow">Discover</p>
        <a href="/learn/soda-firing/">What soda firing is</a>
        <a href="/surfaces/">About the surfaces</a>
        <a href="/care/">Care and questions</a>
        <a href="/studio/">Our story</a>
      </div>
      <div class="mega__promos">
        {[{ p: promo, label: 'New mugs', href: '/collection/?category=mugs' }, { p: promo2, label: 'Vases and jars', href: '/collection/?category=vases-and-jars' }].map(({ p, label, href }) => (
          <a href={href} class="mega__promo">
            <img src={cover(p)} alt="" loading="lazy" width="570" height="713" />
            <span>{label} &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </div>

  <nav class="quick" aria-label="Quick links">
    <div class="wrap quick__inner">
      {quick.map((q) => <a href={q.href}>{q.label}</a>)}
    </div>
  </nav>
</header>

<script>
  // Rotate the announcement bar.
  const msgs = Array.from(document.querySelectorAll<HTMLElement>('.announce__msg'));
  let at = 0;
  const show = (n: number) => {
    msgs[at]?.classList.remove('is-active');
    at = (n + msgs.length) % msgs.length;
    msgs[at]?.classList.add('is-active');
  };
  let timer = window.setInterval(() => show(at + 1), 6000);
  document.querySelectorAll<HTMLButtonElement>('[data-announce]').forEach((b) =>
    b.addEventListener('click', () => {
      window.clearInterval(timer);
      show(at + Number(b.dataset.announce));
      timer = window.setInterval(() => show(at + 1), 6000);
    }),
  );

  // Open and close the Shop menu.
  const toggle = document.querySelector<HTMLButtonElement>('.shop-toggle');
  const mega = document.querySelector<HTMLElement>('#mega');
  const setOpen = (open: boolean) => {
    if (!toggle || !mega) return;
    toggle.setAttribute('aria-expanded', String(open));
    mega.hidden = !open;
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  document.addEventListener('click', (e) => {
    const t = e.target as Node;
    if (mega && toggle && !mega.contains(t) && !toggle.contains(t)) setOpen(false);
  });
</script>

<style>
  .announce {
    background: var(--ink);
    color: var(--cream);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 0 var(--gutter);
    height: 2.4rem;
    font-size: 0.8rem;
  }
  .announce__track {
    position: relative;
    flex: 0 1 44rem;
    height: 100%;
    text-align: center;
  }
  .announce__msg {
    position: absolute;
    inset: 0;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.5s ease;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .announce__msg.is-active {
    opacity: 1;
  }
  .announce__arrow {
    background: none;
    border: 0;
    color: inherit;
    font-size: 1.2rem;
    cursor: pointer;
    padding: 0 0.5rem;
    opacity: 0.75;
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--cream);
    border-bottom: 1px solid var(--line);
  }
  .header__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 4.5rem;
    font-size: 0.95rem;
  }
  .header__left,
  .header__right {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.2vw, 2rem);
  }
  .header__right {
    justify-content: flex-end;
  }
  .header__left a,
  .header__right a,
  .shop-toggle {
    padding: 0.35rem 0;
    border-bottom: 1px solid transparent;
  }
  .header__left a:hover,
  .header__left a[aria-current='page'],
  .header__right a:hover {
    border-color: currentColor;
  }
  .shop-toggle {
    background: none;
    border-top: 0;
    border-left: 0;
    border-right: 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 500;
  }
  .chev {
    display: inline-block;
    transform: translateY(-0.2em);
    transition: transform 0.2s ease;
  }
  .shop-toggle[aria-expanded='true'] .chev {
    transform: translateY(0.15em) rotate(180deg);
  }
  .wordmark {
    font-family: var(--serif);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1;
    font-variation-settings: 'opsz' 144;
  }
  .bag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .mega {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 30px 40px -30px rgba(36, 31, 27, 0.25);
  }
  .mega__inner {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 2fr;
    gap: 2.5rem;
    padding-top: 2.25rem;
    padding-bottom: 2.5rem;
  }
  .mega__col {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .mega__col .eyebrow {
    margin-bottom: 0.5rem;
  }
  .mega__col a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1rem;
  }
  .mega__col a span:not(.swatch) {
    color: var(--stone);
    font-size: 0.8rem;
  }
  .mega__col a:hover {
    color: var(--rust);
  }
  .mega__all {
    font-weight: 500;
  }
  .mega__promos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .mega__promo img {
    aspect-ratio: 1;
    object-fit: cover;
    width: 100%;
    border-radius: var(--radius);
  }
  .mega__promo span {
    display: block;
    margin-top: 0.6rem;
    font-weight: 500;
  }

  .quick {
    border-top: 1px solid var(--line);
  }
  .quick__inner {
    display: flex;
    justify-content: center;
    gap: clamp(1rem, 2.5vw, 2.25rem);
    height: 2.75rem;
    align-items: center;
    font-size: 0.85rem;
    overflow-x: auto;
    scrollbar-width: none;
    white-space: nowrap;
  }
  .quick__inner::-webkit-scrollbar {
    display: none;
  }
  .quick a:hover {
    color: var(--rust);
  }

  @media (max-width: 900px) {
    .hide-sm {
      display: none;
    }
    .header__bar {
      height: 3.75rem;
    }
    .quick__inner {
      justify-content: flex-start;
    }
    .mega {
      max-height: calc(100vh - 7rem);
      overflow-y: auto;
    }
    .mega__inner {
      grid-template-columns: 1fr 1fr;
      gap: 2rem 1.5rem;
    }
    .mega__promos {
      grid-column: 1 / -1;
    }
    .announce {
      font-size: 0.72rem;
      height: 2.8rem;
      gap: 0.25rem;
    }
    .announce__msg {
      white-space: normal;
      line-height: 1.25;
      text-align: center;
    }
  }
</style>
